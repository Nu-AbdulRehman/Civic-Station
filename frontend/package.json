{
  "name": "civic-station-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "gen:types": "uv run --project ../backend python ../scripts/export_openapi.py src/api/openapi.json && openapi-typescript src/api/openapi.json --enum-values -o src/api/types.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage",
    "scan:bundle": "python ../scripts/scan_bundle.py dist"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "6.4.3",
    "vitest": "5.0.2"
  }
}
