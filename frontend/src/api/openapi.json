        "tags": [
          "ops"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Ready Ready Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "A dependency is unreachable; names which one"
