# Rendered at container start by entrypoint.sh (ADR-0002). Only ${BACKEND_ORIGIN} is
# substituted; every other $variable here is nginx's own and must survive envsubst untouched.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    location /api {
        proxy_pass ${BACKEND_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Without this the backend sees every request as coming from nginx and the per-IP
        # rate limiter becomes one global bucket (05-M4-cache §2.2, AD-054).
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Worst case triage is ~21 s; the documented ceiling is 31 s (BR-TRIAGE-008).
        proxy_read_timeout 31s;
    }

    # Client-side routes (/dashboard, /stats) are served by the SPA shell.
    location / {
        try_files $uri /index.html;
    }
}
